@model IList<ManufacturerBriefInfoModel>

@using Nop.Core.Domain.Catalog
@{
    var themes = "";
}
@if (Model.Count > 0)
{
    <div class="manufacturers">
        @if (Model.Count == 1)
        {
            <span class="label">@T("Products.Manufacturer"):</span>
        }
        else
        {
            <span class="label">@T("Products.Manufacturers"):</span>
        }
        <span class="value">
            @for (var i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                themes += "\"" + NopHtml.StripSpecialCharacters(item.Name).ToString() + "\",";
                <a href="@(Url.RouteUrl<Manufacturer>(new { SeName = item.SeName }))">@item.Name</a>
                if (i != Model.Count - 1)
                {
                    <span class="separator">,</span>
                }
            }
            @if (themes.Length > 0)
            {
                themes = themes.TrimEnd(',');
            }
        </span>
    </div>
}

<script>
    digitalData.product[0].productInfo.attributes.theme = [@Html.Raw(themes)];
</script>
@model ProductDetailsModel.ProductBreadcrumbModel

@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Common

@inject CommonSettings commonSettings

@{
    var breadcrumbDelimiter = commonSettings.BreadcrumbDelimiter;
    var bcList = "";

    NopHtml.AddJsonLdParts(Model.JsonLd);
}
@if (Model.Enabled)
{
    <div class="breadcrumb">
        <ul>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBreadcrumbBefore, additionalData = Model })
            <li>
                <span>
                    <a href="@Url.RouteUrl("Homepage")">
                        <span>@T("Products.Breadcrumb.Top")</span>
                    </a>
                </span>
                <span class="delimiter">@breadcrumbDelimiter</span>
            </li>            
            @foreach (var category in Model.CategoryBreadcrumb)
            {
                <li>
                    <a href="@(Url.RouteUrl<Category>(new { SeName = category.SeName }))">
                        <span>@category.Name</span>
                    </a>
                    <span class="delimiter">@breadcrumbDelimiter</span>
                </li>
            }
            @if (bcList.Length > 0)
            {
                bcList = bcList.TrimEnd(',');
            }
            <li>
                <strong class="current-item">@Model.ProductName</strong>
                <span id="@(Url.RouteUrl<Product>(new { SeName = Model.ProductSeName }))"></span>              
                @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductBreadcrumbAfter, additionalData = Model })
            </li>
        </ul>
    </div>
}    <script>
         digitalData.page.pageInfo.breadCrumbs = [@Html.Raw(bcList)];
         if (digitalData.page.pageInfo.breadCrumbs.length > 0) {
             digitalData.page.category.primaryCategory = digitalData.page.pageInfo.breadCrumbs[0];
         }
         if (digitalData.page.pageInfo.breadCrumbs.length > 1) {
             digitalData.page.category.subCategory1 = digitalData.page.pageInfo.breadCrumbs[1];
         }
         if (digitalData.page.pageInfo.breadCrumbs.length > 2) {
             digitalData.page.category.subCategory2 = digitalData.page.pageInfo.breadCrumbs[2];
         }
         digitalData.page.category.pageType = "pdp";
</script>
